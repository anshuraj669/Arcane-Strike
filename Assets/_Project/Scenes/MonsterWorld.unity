  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 69142509}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb6c0d34fe647c5afbf3c02f47639dab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArcaneStrike.Story.RiftArena
  waves:
  - name: First Blood
    shades: 6
    lurkers: 0
    brutes: 0
    maxAlive: 3
    emberLines:
    - 'Here they come. Swing hard: the faster the blade moves, the deeper it bites.'
  - name: The Swarm
    shades: 4
    lurkers: 6
    brutes: 0
    maxAlive: 4
    emberLines:
    - 'Lurkers! Small and quick. Drive the point straight at them: a thrust goes
      right through.'
    - And when one rears back to strike, hold your blade across in front of you.
      Parry it, then cut it down while it reels.
  - name: Heavy Shadows
    shades: 6
    lurkers: 4
    brutes: 2
    maxAlive: 5
    emberLines:
    - Brutes. Little cuts won't even make them flinch.
    - 'Raise your blade high and bring it down hard: smash the ground. And if they
      surround you, sweep all the way round.'
  - name: The Tide
    shades: 8
    lurkers: 6
    brutes: 2
    maxAlive: 6
    emberLines:
    - This is all of them. Hold the sword upright and still... let the light gather
      in the blade...
    - ...then slash, and send it flying. Show them what a Weaver is.
  shadeModel: {fileID: 8022397101854499114, guid: 07f5b69261b8af91087afcbbe3afaeb0, type: 3}
  lurkerModel: {fileID: 8022397101854499114, guid: 07f5b69261b8af91087afcbbe3afaeb0, type: 3}
  bruteModel: {fileID: 8022397101854499114, guid: 07f5b69261b8af91087afcbbe3afaeb0, type: 3}
  bossModel: {fileID: 3501992628836765507, guid: 948f5a75fc26de100af315a8e5234ee1, type: 3}
  spawnMin: 4.5
  spawnMax: 8
  entrance: {fileID: 1000338971}
  farEnd: {fileID: 46979973}
  fogColor: {r: 0.06, g: 0.02, b: 0.09, a: 1}
  fogDensity: 0.045
  ascensionOnArrival: 0
  riftAtmosphere: 0
  arrivalLines:
  - 'We''re through. This is their world, Weaver: the Kalakh''s world.'
  - Bare rock, a dead moon, and not one honest light in it. Nothing here has seen
    true light in a thousand years.
  hunt: {fileID: 69142515}
  restartScene: AscensionCave
  nextScene: 
  keyboardFallback: 1
